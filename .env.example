# Used by docker-compose.yml (interpolation only). Copy to .env, never commit .env.
POSTGRES_USER=learnspace
POSTGRES_PASSWORD=learnspace
POSTGRES_DB=learnspace

# Required by the containerised server. Generate your own:
#   openssl rand -base64 48        (Git Bash / WSL)
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars

