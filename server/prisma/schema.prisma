// ---------------------------------------------------------------- identity

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique @db.Citext
  name             String    @db.VarChar(100)
  passwordHash     String?
  emailVerified    Boolean    @default(false)
  role             UserRole   @default(student)
  status           UserStatus @default(active)
  suspendedAt      DateTime?  @db.Timestamptz(3)
  suspendedReason  String?    @db.VarChar(500)
  twoFactorEnabled     Boolean    @default(false)
  adminPermissionsJson Json       @default("{\"can_manage_users\":true,\"can_moderate_content\":true,\"can_view_ai_usage\":true,\"can_send_announcements\":true,\"can_export_data\":true}")
  lastActiveAt         DateTime?  @db.Timestamptz(3)
  studentId        String?    @db.VarChar(50)
  programme        String?   @db.VarChar(120)
  level            String?   @db.VarChar(30)
  university       String?   @db.VarChar(120)
  bio                     String?   @db.VarChar(500)
  avatarUrl               String?
  avatarPublicId          String?
  avatarConfig            Json?
  termsAccepted           Boolean   @default(false)
  termsVersion            String?   @db.VarChar(32)
  termsAcceptedAt         DateTime? @db.Timestamptz(3)
  privacyPolicyVersion    String?   @db.VarChar(32)
  privacyPolicyAcceptedAt DateTime? @db.Timestamptz(3)
  failedLoginCount        Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)
  tokensValidAfter        DateTime? @db.Timestamptz(3)
  firstLoginAt            DateTime? @db.Timestamptz(3)
  lastLoginAt             DateTime? @db.Timestamptz(3)
  onboardingCompleted     Boolean   @default(false)
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  identities     AuthIdentity[]
  refreshTokens  RefreshToken[]
  emailTokens    EmailToken[]
  otpCodes       OtpCode[]
  settings       UserSettings?
  conversations  Conversation[]
  messages       Message[]
  aiUsage        AiUsageDaily[]
  courses        Course[]
  notes            Note[]
  tasks            Task[]
  timetableEntries TimetableEntry[]
  exams            Exam[]
  revisionPlans    RevisionPlan[]
  revisionSessions RevisionSession[]
  notifications    Notification[]
  studySessions  StudySession[]
  decks          Deck[]
  reviewLogs     ReviewLog[]
  gradingScales  GradingScale[]
  gradeRecords   GradeRecord[]
  quizzes        Quiz[]
  quizAttempts   QuizAttempt[]
  studyDocuments           StudyDocument[]
  documentChunks           DocumentChunk[]
  attachments              MessageAttachment[]
  documents                Document[]
  documentJobs             DocumentJob[]
  extractedQuestions       ExtractedQuestion[]
  generatedQuestionSets    GeneratedQuestionSet[]
  documentPracticeAttempts DocumentPracticeAttempt[]
  auditLogsAsActor         AuditLog[]
  announcementsAuthored    Announcement[]
  feedbackReports          FeedbackReport[]
  flaggedTargets           FlaggedContent[]         @relation("FlagTargetUser")
  flaggedReports           FlaggedContent[]         @relation("FlagReporter")
  usageEvents              UsageEvent[]
  activityEvents           ActivityEvent[]
  loginHistory             LoginHistory[]
  avatar                   UserAvatar?
  courseRecommendations    CourseRecommendation[]
  courseResources          CourseResource[]
  recommendationJobs       RecommendationJob[]
  recommendationReports    RecommendationReport[]
  communityProfile         UserCommunityProfile?
  communityMemberships     CommunityMember[]
  communityPosts           CommunityPost[]
  communityReplies         CommunityReply[]
  communityVotes           CommunityVote[]
  communityAttachments     CommunityAttachment[]
  studyGroupMemberships    StudyGroupMember[]
  studyGroupMessages       StudyGroupMessage[]
  studyGroupTasks          StudyGroupTask[]
  sharedResources          SharedResource[]
  communityReportsFiled    CommunityReport[]              @relation("CommunityReportReporter")
  communityReportsAgainst  CommunityReport[]              @relation("CommunityReportTargetUser")
  blocksInitiated          UserBlock[]                    @relation("UserBlockBlocker")
  blocksReceived           UserBlock[]                    @relation("UserBlockBlocked")
  moderationActionsActor   ModerationAction[]             @relation("ModerationActionActor")
  moderationActionsTarget  ModerationAction[]             @relation("ModerationActionTargetUser")
  communityNotifPrefs      CommunityNotificationPreference?

  @@index([role])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model UserAvatar {
  userId    String   @id @db.Uuid
  mimeType  String   @db.VarChar(50)
  data      Bytes
  etag      String   @db.VarChar(64)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

model AuthIdentity {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid
  persistent   Boolean   @default(false)
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime       @db.Timestamptz(3)
  usedAt    DateTime?      @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

model UserSettings {
  userId               String    @id @db.Uuid
  theme                ThemePref @default(system)
  timezone             String    @default("UTC")
  notifyInApp          Boolean   @default(true)
  notifyEmailReminders Boolean   @default(false)
  notifyProductEmail   Boolean   @default(false)
  focusMinutes         Int       @default(25)
  shortBreakMinutes    Int       @default(5)
  longBreakMinutes     Int       @default(15)
  classReminderMinutes Int       @default(15)
  examReminderMinutes  Int       @default(1440)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ---------------------------------------------------------------- AI chat

model Conversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  courseId  String?  @db.Uuid
  title     String   @default("New chat") @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  messages    Message[]
  attachments MessageAttachment[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, courseId])
  @@map("conversations")
}

model Message {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @db.Uuid
  userId         String        @db.Uuid
  role           MessageRole
  content        String
  status         MessageStatus @default(complete)
  action         AiAction?
  inputTokens    Int?
  outputTokens   Int?
  model          String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @db.Uuid
  conversationId String         @db.Uuid
  messageId      String?        @db.Uuid
  originalName   String         @db.VarChar(255)
  mimeType       String         @db.VarChar(120)
  kind           AttachmentKind
  sizeBytes      Int
  storageKey     String
  storageUrl     String
  extractedText  String?
  truncated      Boolean        @default(false)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([messageId])
  @@map("message_attachments")
}

model AiUsageDaily {
  userId       String @db.Uuid
  day          DateTime @db.Date
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
  requests     Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("ai_usage_daily")
}

// ---------------------------------------------------------------- notes and planner

model Course {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  name        String    @db.VarChar(80)
  code        String?   @db.VarChar(24)
  lecturer    String?   @db.VarChar(120)
  creditHours Float?
  semester    String?   @db.VarChar(60)
  level       String?   @db.VarChar(30)
  color       String?   @db.VarChar(7)
  courseNotes String?   @db.VarChar(4000)
  archivedAt              DateTime? @db.Timestamptz(3)
  useResourcesInAssistant Boolean   @default(false)
  communityId             String?   @db.Uuid
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  community           Community?             @relation(fields: [communityId], references: [id], onDelete: SetNull)
  notes               Note[]
  tasks               Task[]
  timetableEntries    TimetableEntry[]
  exams               Exam[]
  revisionSessions    RevisionSession[]
  documents           Document[]
  conversations       Conversation[]
  studySessions       StudySession[]
  decks               Deck[]
  reviewLogs          ReviewLog[]
  gradeRecords        GradeRecord[]
  quizzes             Quiz[]
  studyDocuments      StudyDocument[]
  recommendations     CourseRecommendation[]
  resources           CourseResource[]
  recommendationJobs  RecommendationJob[]

  @@index([userId])
  @@index([userId, archivedAt])
  @@index([userId, semester])
  @@map("courses")
}

model Note {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                   @db.Uuid
  courseId     String?                  @db.Uuid
  title        String                   @db.VarChar(200)
  body         String                   @default("")
  aiSummary    String?
  // Generated column (title weight A, body weight B); created in the migration SQL.
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  decks  Deck[]
  quizzes Quiz[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, courseId])
  @@map("notes")
}

model Task {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String       @db.Uuid
  courseId              String?      @db.Uuid
  title                 String       @db.VarChar(200)
  description           String?
  dueAt                 DateTime?    @db.Timestamptz(3)
  priority              TaskPriority @default(medium)
  status                TaskStatus   @default(todo)
  completedAt           DateTime?    @db.Timestamptz(3)
  reminderOffsetMinutes Int?
  remindAt              DateTime?    @db.Timestamptz(3)
  reminderSentAt        DateTime?    @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  notifications   Notification[]
  studySessions   StudySession[]
  revisionSession RevisionSession?

  @@index([userId, status, dueAt])
  @@index([userId, courseId])
  @@map("tasks")
}

model Exam {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @db.Uuid
  courseId        String    @db.Uuid
  title           String    @db.VarChar(160)
  examType        ExamType  @default(final)
  startsAt        DateTime  @db.Timestamptz(3)
  durationMinutes Int?
  venue           String?   @db.VarChar(120)
  weightPercent   Float?
  topicsJson      Json      @default("[]")
  notes           String?   @db.VarChar(2000)
  reminderSentAt  DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  notifications    Notification[]
  revisionSessions RevisionSession[]

  @@index([userId, startsAt])
  @@index([userId, courseId, startsAt])
  @@map("exams")
}

model RevisionPlan {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @db.Uuid
  title              String             @db.VarChar(160)
  startDate          DateTime           @db.Date
  endDate            DateTime           @db.Date
  hoursPerDay        Float
  daysOffJson        Json               @default("[]")
  preferredTimesJson Json               @default("[\"evening\"]")
  status             RevisionPlanStatus @default(active)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions RevisionSession[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@map("revision_plans")
}

model RevisionSession {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId          String                @db.Uuid
  userId          String                @db.Uuid
  examId          String?               @db.Uuid
  courseId        String?               @db.Uuid
  taskId          String?               @unique @db.Uuid
  scheduledDate   DateTime              @db.Date
  startTime       String                @db.VarChar(5)
  durationMinutes Int
  topic           String                @db.VarChar(200)
  notes           String?               @db.VarChar(1000)
  status          RevisionSessionStatus @default(planned)
  position        Int                   @default(0)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @default(now()) @updatedAt @db.Timestamptz(3)

  plan   RevisionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam   Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)
  course Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  task   Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledDate])
  @@index([planId, scheduledDate, position])
  @@map("revision_sessions")
}

model TimetableEntry {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String             @db.Uuid
  courseId        String             @db.Uuid
  dayOfWeek       Int                @db.SmallInt
  startMinute     Int
  endMinute       Int
  venue           String?            @db.VarChar(120)
  type            TimetableEntryType @default(lecture)
  reminderEnabled Boolean            @default(true)
  reminderMinutes Int?
  lastReminderKey String?            @db.VarChar(160)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId, dayOfWeek, startMinute])
  @@index([userId, courseId])
  @@map("timetable_entries")
}

model Notification {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String           @db.Uuid
  type             NotificationType
  title            String           @db.VarChar(200)
  body             String
  taskId           String?          @db.Uuid
  timetableEntryId String?          @db.Uuid
  examId           String?          @db.Uuid
  occurrenceKey    String?          @db.VarChar(160)
  dueAtSnapshot    DateTime?        @db.Timestamptz(3)
  readAt           DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  timetableEntry TimetableEntry? @relation(fields: [timetableEntryId], references: [id], onDelete: SetNull)
  exam           Exam?           @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@unique([taskId, type, dueAtSnapshot])
  @@unique([userId, type, occurrenceKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([timetableEntryId])
  @@index([examId])
  @@map("notifications")
}

model StudySession {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String             @db.Uuid
  taskId          String?            @db.Uuid
  courseId        String?            @db.Uuid
  kind            StudySessionKind   @default(focus)
  startedAt       DateTime           @db.Timestamptz(3)
  durationSeconds Int
  source          StudySessionSource @default(pomodoro)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  // Also makes POST /study-sessions idempotent across retries.
  @@unique([userId, startedAt])
  @@index([userId, courseId])
  @@map("study_sessions")
}

// ---------------------------------------------------------------- flashcards and quizzes

model Deck {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  noteId     String?  @db.Uuid
  documentId String?  @db.Uuid
  courseId   String?  @db.Uuid
  title      String   @db.VarChar(150)
  topic      String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  note                  Note?                  @relation(fields: [noteId], references: [id], onDelete: SetNull)
  document              Document?              @relation(fields: [documentId], references: [id], onDelete: SetNull)
