// LearnSpace database schema. Keep in sync with docs/DATABASE.md.
// Things Prisma cannot express (CHECK constraints, partial/expression/GIN indexes)
// live in migrations/20261116000100_constraints_and_search/migration.sql.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ---------------------------------------------------------------- enums

enum ThemePref {
  system
  light
  dark
}

enum AuthProvider {
  google
}

enum EmailTokenType {
  verify_email
  reset_password
  admin_2fa
  super_step_up
}

enum UserRole {
  student
  admin
  super_admin
}

enum UserStatus {
  active
  suspended
}

enum AnnouncementAudience {
  all
  programme
  level
}

enum FeedbackCategory {
  bug
  suggestion
  abuse
}

enum FeedbackStatus {
  new
  in_progress
  resolved
}

enum FlagStatus {
  open
  dismissed
  warned
  suspended
}

enum UsageFeature {
