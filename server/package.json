{
  "name": "@learnspace/server",
  "version": "0.1.0",
  "private": true,
  "description": "LearnSpace REST API",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "admin:seed": "tsx prisma/seedAdmin.ts",
    "email:test": "tsx scripts/sendTestEmail.ts",
    "storage:test": "tsx scripts/testStorage.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@prisma/client": "5.22.0",
    "adm-zip": "^0.6.1",
    "argon2": "^0.41.1",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.15.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "mammoth": "^1.13.0",
    "mathjs": "^15.2.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prisma": "7.10.1",
    "resend": "^4.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.4",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4"
  }
}
