# Copy to server/.env for running the API with `npm run dev` (outside Docker).
# NEVER commit server/.env. Every variable is validated at boot (src/config/env.ts).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://learnspace:learnspace@localhost:5433/learnspace?schema=public

# Secret for signing access tokens. Min 32 chars. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars

# Where the React app runs, and which origins may call the API (comma separated)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (0 locally, 1 on Render)
TRUST_PROXY=0

# Requests per minute per IP across the API
RATE_LIMIT_GLOBAL_PER_MIN=300

# ---- Needed in later phases (leave blank until then) ----
# Phase 2: email (Resend, Gmail SMTP smtps://user%40gmail.com:APP_PASS@smtp.gmail.com:465, or Mailpit smtp://localhost:1025)
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=
# Phase 2 (optional): Continue with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback
# Phase 3: avatar storage, format cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Phase 4: LLM (Z.ai GLM via NVIDIA Build integrate.api.nvidia.com/v1, or Gemini fallback)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3-flash
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
GEMINI_API_KEY=

# Admin bootstrap (used by `npm run admin:seed -w server`)
ADMIN_EMAIL=

# Optional extra passcode prompt required to unlock /admin console
ADMIN_CONSOLE_PASSWORD=

# Optional EmailJS server provider (switchable via EMAIL_PROVIDER=auto|resend|smtp|emailjs)
EMAIL_PROVIDER=auto
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
