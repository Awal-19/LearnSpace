# Copy to server/.env for running the API with `npm run dev` (outside Docker).
# NEVER commit server/.env. Every variable is validated at boot (src/config/env.ts).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://learnspace:learnspace@localhost:5433/learnspace?schema=public

# Secret for signing access tokens. Min 32 chars. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars

# Where the React app runs, and which origins may call the API (comma separated)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (0 locally, 1 on Render)
TRUST_PROXY=0

# Requests per minute per IP across the API
RATE_LIMIT_GLOBAL_PER_MIN=300

# ---- Needed in later phases (leave blank until then) ----
# Phase 2: email (auto | resend | brevo | smtp | emailjs)
EMAIL_PROVIDER=auto
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_URL=
EMAIL_FROM="LearnSpace <no-reply@learnspace.app>"
EMAIL_REPLY_TO=support@learnspace.app
# Phase 2 (optional): Continue with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback
# Phase 3: avatar storage, format cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Phase 4: LLM (Z.ai GLM via NVIDIA Build integrate.api.nvidia.com/v1, or Gemini fallback)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3-flash
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
GEMINI_API_KEY=

# Admin bootstrap (used by `npm run admin:seed -w server`)
ADMIN_EMAIL=

# Optional extra passcode prompt required to unlock /admin console
ADMIN_CONSOLE_PASSWORD=

# Optional EmailJS server provider (switchable via EMAIL_PROVIDER=auto|resend|smtp|emailjs)
EMAIL_PROVIDER=auto
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_RESET_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Optional bot protection on signup & OTP resend (Cloudflare Turnstile or hCaptcha)
TURNSTILE_SECRET_KEY=
HCAPTCHA_SECRET_KEY=

# Optional HTTP malware scanner (e.g., ClamAV REST sidecar) for file uploads
MALWARE_SCANNER_URL=

# Optional Sentry DSN for 5xx error tracking (sensitive fields are scrubbed before sending)
SENTRY_DSN=

# Voice dictation / speech-to-text (server-side fallback & High Accuracy mode)
# Provider options: nvidia_riva (default, Parakeet TDT 0.6B v2 via NVCF gRPC), openai_http, gemini
STT_PROVIDER=nvidia_riva
NVIDIA_ASR_GRPC_URL=grpc.nvcf.nvidia.com:443
NVIDIA_ASR_FUNCTION_ID=d3fe9151-442b-4204-a70d-5fcc597fd610
# Optional OpenAI-compatible HTTP transcription fallback (when STT_PROVIDER=openai_http)
STT_HTTP_URL=
STT_HTTP_API_KEY=
STT_HTTP_MODEL=whisper-1
# Per-user daily voice transcription quota & daily spend alert threshold (USD)
AI_DAILY_TRANSCRIPTION_LIMIT=60
AI_TRANSCRIPTION_COST_ALERT_USD=5
