# Vite exposes only variables prefixed with VITE_ to the browser. NEVER put secrets here.

# API base URL. Leave as-is locally (Vite proxies /api to the server).
# In production set the full URL, e.g. https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Dev proxy target (Docker sets this to http://server:4000)
VITE_PROXY_TARGET=http://localhost:4000


# Optional EmailJS for browser-sent non-sensitive contact/feedback forms (no secrets!)
VITE_EMAILJS_SERVICE_ID=service_x4ayh48
VITE_EMAILJS_TEMPLATE_ID=template_uku1rwk
VITE_EMAILJS_PUBLIC_KEY=GrqGZrtyNyMSfFUMJ
