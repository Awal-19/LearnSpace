{
  "name": "learnspace",
  "version": "0.1.0",
  "private": true,
  "description": "LearnSpace: AI-powered learning platform for university students",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "client",
    "server",
    "e2e"
  ],
  "scripts": {
    "setup": "npm install && npm run db:generate",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "test": "npm run test -w server && npm run test -w client",
    "test:coverage": "npm run test:coverage -w server && npm run test:coverage -w client",
    "test:e2e": "npm run test:e2e -w e2e",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:studio": "npm run db:studio -w server",
    "db:reset": "npm run db:reset -w server",
    "prepare": "husky || exit 0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@netlify/edge-functions": "^4.0.4",
    "concurrently": "^9.0.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "jsdom": "^31.0.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3"
  }
}
